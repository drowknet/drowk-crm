# Deny by default. Only packaging inputs and required workspace sources enter builds.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!packages/
!packages/contracts/
!packages/domain/
!packages/db/
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/src/**
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/**
!packages/db/package.json
!packages/db/tsconfig.json
!packages/db/src/**
!packages/db/migrations/*.sql
!services/
!services/api/
!services/worker/
!services/api/package.json
!services/api/tsconfig.json
!services/api/src/**
!services/worker/package.json
!services/worker/tsconfig.json
!services/worker/src/**
!tooling/
!tooling/runtime/
!tooling/runtime/pack.mjs
# Defense in depth even beneath allowlisted source directories.
**/.git
**/.env*
**/node_modules
**/dist
**/test
**/tests
**/fixtures
**/docs
**/secrets
**/*.pem
**/*.key
**/credentials*.json
connectors
capabilities
apps
