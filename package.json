{
  "name": "@drowk/crm",
  "version": "0.0.0",
  "private": true,
  "description": "DROWK CRM — Revenue Intelligence & Prospecting Operating System",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm build && pnpm -r --if-present test",
    "lint": "node tooling/harness/lint.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "secrets:scan": "node tooling/harness/secrets.mjs all",
    "secrets:tree": "node tooling/harness/secrets.mjs tree",
    "secrets:history": "node tooling/harness/secrets.mjs history",
    "harness:test": "node --test tooling/harness/*.test.mjs tooling/governance/*.test.mjs",
    "harness:preflight": "node tooling/harness/run.mjs preflight",
    "harness:fast": "node tooling/harness/run.mjs fast",
    "harness:full": "node tooling/harness/run.mjs full",
    "harness:ci": "node tooling/harness/run.mjs ci",
    "harness:integration": "node tooling/harness/run.mjs integration",
    "governance:test": "node --test tooling/governance/verify-main-protection.test.mjs",
    "governance:verify": "node tooling/governance/verify-main-protection.mjs",
    "runtime:test": "node --test tooling/runtime/*.test.mjs",
    "runtime:verify": "node tooling/runtime/verify.mjs",
    "staging:test": "node --test tooling/staging/staging.test.mjs",
    "staging:verify": "node tooling/staging/verify.mjs",
    "staging:preflight": "node tooling/staging/preflight.mjs",
    "staging:rollback-plan": "node tooling/staging/cli.mjs rollback-plan",
    "staging:kill-plan": "node tooling/staging/cli.mjs kill-plan",
    "oss:scan": "node tooling/harness/public-oss.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "eslint": "10.11.0",
    "@typescript-eslint/parser": "8.71.0"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/drowknet/drowk-crm.git"
  },
  "engines": {
    "node": "22.x"
  }
}
